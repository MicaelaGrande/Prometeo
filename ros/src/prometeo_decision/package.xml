<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prometeo_decision</name>
  <version>0.0.0</version>
  <description>Decision del robot Prometeo: elige un color y sigue sus flechas hasta el cubo</description>
  <maintainer email="natasha.vodanovich@mi.unc.edu.ar">natasha</maintainer>
  <license>TODO: License declaration</license>

  <!-- Otros paquetes que este necesita. Por ahora solo pytest, para las pruebas:
       la logica es Python comun y todavia no habla con ROS. -->
  <test_depend>python3-pytest</test_depend>

  <!-- Le indica a colcon que este paquete es de Python, no de C++ -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

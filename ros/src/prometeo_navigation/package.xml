<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prometeo_navigation</name>
  <version>0.0.0</version>
  <description>Navegacion autonoma del robot Prometeo: libreta del recorrido y exploracion</description>
  <maintainer email="micaela.grande@mi.unc.edu.ar">micaela</maintainer>
  <license>TODO: License declaration</license>

  <!-- Otros paquetes que este necesita. La libreta y lugares.py son Python comun;
       el selector de modo (T11) si habla con ROS. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Le indica a colcon que este paquete es de Python, no de C++ -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

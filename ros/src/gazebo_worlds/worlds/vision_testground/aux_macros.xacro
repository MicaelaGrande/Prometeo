<?xml version="1.0" ?>
<!--
  xacro version of colored_objects.sdf

  Generate the SDF, then run it in Gazebo:
      xacro colored_objects.sdf.xacro -o colored_objects.sdf
      gz sim -r colored_objects.sdf

  Override any argument from the command line:
      xacro colored_objects.sdf.xacro head_w:=0.08 thick:=0.01 -o colored_objects.sdf

  Layout (seen from the robot at the origin; +X forward, +Y left):
      wall at x = 2.0, three arrows on its face, three 3 cm boxes on the floor in front of it.
-->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ===== Macros ===== -->

  <!-- Material from a named color (see COLORS in common_properties.xacro) -->
  <xacro:macro name="paint" params="material">
    <material>
      <ambient>${COLORS[material]} 1</ambient>
      <diffuse>${COLORS[material]} 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </material>
  </xacro:macro>

  <!-- Flat arrow glued to the face of the wall ahead of a corridor cell.
       x, y = cell (grid units), px = heading of the robot (same units as NORTH/WEST/... yaw/(pi/2)),
       dir = 1 points to the robot's right, -1 to its left, L = body length (m).
       The slot (height on the wall) depends on the color so up to three arrows fit one above the other. -->
  <xacro:macro name="arrow" params="name x y px dir L material">
    <model name="arrow_${name}">
      <static>true</static>
      <!-- Model +x = wall normal pointing at the robot, model +y = robot's right -->
      <pose>${x*wall_width + cos(px*pi/2)*(wall_width/2 - wall_thick/2)} ${y*wall_width + sin(px*pi/2)*(wall_width/2 - wall_thick/2)} ${0.11 - 0.04*SLOT[material]} 0 0 ${(px+2)*pi/2}</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0 0 ${pi/2} 0</pose>
          <geometry>
            <polyline>
              <xacro:if value="${dir > 0}">
                <point>${-body_w / 2} ${-(L + head_h) / 2}</point>
                <point>${body_w / 2} ${-(L + head_h) / 2}</point>
                <point>${body_w / 2} ${L - (L + head_h) / 2}</point>
                <point>${head_w / 2} ${L - (L + head_h) / 2}</point>
                <point>0 ${(L + head_h) / 2}</point>
                <point>${-head_w / 2} ${L - (L + head_h) / 2}</point>
                <point>${-body_w / 2} ${L - (L + head_h) / 2}</point>
              </xacro:if>
              <xacro:if value="${0 > dir}">
                <point>${-body_w / 2} ${-(L - (L + head_h) / 2)}</point>
                <point>${-head_w / 2} ${-(L - (L + head_h) / 2)}</point>
                <point>0 ${-(L + head_h) / 2}</point>
                <point>${head_w / 2} ${-(L - (L + head_h) / 2)}</point>
                <point>${body_w / 2} ${-(L - (L + head_h) / 2)}</point>
                <point>${body_w / 2} ${(L + head_h) / 2}</point>
                <point>${-body_w / 2} ${(L + head_h) / 2}</point>
              </xacro:if>
              <height>${thick}</height>
            </polyline>
          </geometry>
          <xacro:paint material="${material}"/>
        </visual>
      </link>
    </model>
  </xacro:macro>

  <!-- Arrow length encodes the segments to the next curve: 1 = close, 2 = middle, 3 or more = far -->
  <xacro:macro name="close_arrow" params="name x y px dir material">
      <xacro:arrow name="${name}" x="${x}" y="${y}" px="${px}" dir="${dir}" L="0.03" material="${material}"/>
  </xacro:macro>
  <xacro:macro name="middle_arrow" params="name x y px dir material">
      <xacro:arrow name="${name}" x="${x}" y="${y}" px="${px}" dir="${dir}" L="0.06" material="${material}"/>
  </xacro:macro>
  <xacro:macro name="far_arrow" params="name x y px dir material">
      <xacro:arrow name="${name}" x="${x}" y="${y}" px="${px}" dir="${dir}" L="0.1" material="${material}"/>
  </xacro:macro>

  <!-- Area of colored ground -->
  <xacro:macro name="zone" params="name x y px material">
    <model name="${name}">
      <static>true</static>
      <pose>${x} ${y} -0.019 0 0 ${px}</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>${area_size} ${area_size} 0.04</size></box></geometry>
          <xacro:paint material="${material}"/>
        </visual>
      </link>
    </model>
  </xacro:macro>

  <!-- Small cube on a black pedestal. Inertia is computed from the mass and size. -->
  <xacro:macro name="box" params="name x y material">
    <xacro:zone name="objective_marker_${name}" x="${x}" y="${y}" px="0" material="azul" />
    <model name="cylinder_${name}">
    <!-- Raised by half the height so the base rests on the ground plane -->
        <static>true</static>
        <pose>${x} ${y} ${cylinder_height / 2} 0 0 0</pose>
        <link name="cylinder">
            <collision name="cylinder_collision">
                <geometry>
                    <cylinder>
                        <radius>${cylinder_radius}</radius>
                        <length>${cylinder_height}</length>
                    </cylinder>
                </geometry>
            </collision>
            <visual name="cylinder_visual">
                <geometry>
                    <cylinder>
                        <radius>${cylinder_radius}</radius>
                        <length>${cylinder_height}</length>
                    </cylinder>
                </geometry>
                <xacro:paint material="negro"/>
            </visual>
        </link>
    </model>
    <model name="box_${name}">
      <pose>${x} ${y} ${cylinder_height + box_size / 2 + 0.001} 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>${box_mass}</mass>
          <inertia>
            <ixx>${box_mass * 2 * box_size**2 / 12}</ixx>
            <iyy>${box_mass * 2 * box_size**2 / 12}</iyy>
            <izz>${box_mass * 2 * box_size**2 / 12}</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>${box_size} ${box_size} ${box_size}</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>${box_size} ${box_size} ${box_size}</size></box></geometry>
          <xacro:paint material="${material}"/>
        </visual>
      </link>
    </model>
  </xacro:macro>

  <!-- Open-top container: colored floor plus four grey walls. x, y in meters, material = color of the cube it takes -->
  <xacro:macro name="container" params="name x y material">
    <xacro:property name="half" value="${container_size / 2 - container_thick / 2}"/>
    <model name="container_${name}">
      <static>true</static>
      <pose>${x} ${y} 0 0 0 0</pose>
      <link name="link">
        <collision name="floor_collision">
          <pose>0 0 ${container_thick / 2} 0 0 0</pose>
          <geometry><box><size>${container_size} ${container_size} ${container_thick}</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 ${container_thick / 2} 0 0 0</pose>
          <geometry><box><size>${container_size} ${container_size} ${container_thick}</size></box></geometry>
          <xacro:paint material="${material}"/>
        </visual>
        <xacro:container_side name="n" px="0" py="${half}" sx="${container_size}" sy="${container_thick}"/>
        <xacro:container_side name="s" px="0" py="${-half}" sx="${container_size}" sy="${container_thick}"/>
        <xacro:container_side name="e" px="${half}" py="0" sx="${container_thick}" sy="${container_size}"/>
        <xacro:container_side name="w" px="${-half}" py="0" sx="${container_thick}" sy="${container_size}"/>
      </link>
    </model>
  </xacro:macro>
  <xacro:macro name="container_side" params="name px py sx sy">
    <collision name="side_${name}_collision">
      <pose>${px} ${py} ${container_height / 2} 0 0 0</pose>
      <geometry><box><size>${sx} ${sy} ${container_height}</size></box></geometry>
    </collision>
    <visual name="side_${name}_visual">
      <pose>${px} ${py} ${container_height / 2} 0 0 0</pose>
      <geometry><box><size>${sx} ${sy} ${container_height}</size></box></geometry>
      <xacro:paint material="wall"/>
    </visual>
  </xacro:macro>

  <!-- Wall between grid cells: x, y = cell, px = side (0: east of the cell, 1: north, 2: west, 3: south) -->
  <xacro:macro name="wall" params="x y px">
      <model name="wall_${x}_${y}_${px}">
          <static>true</static>
          <pose>${x * wall_width} ${y * wall_width} ${wall_height / 2 - 0.01} 0 0 ${px * pi / 2}</pose>
          <link name="link">
              <collision name="collision">
                  <pose>${wall_width/2} 0 0 0 0 0</pose>
                  <geometry>
                      <box><size>${wall_thick} ${wall_width} ${wall_height}</size></box>
                  </geometry>
              </collision>
              <visual name="visual">
                  <pose>${wall_width/2} 0 0 0 0 0</pose>
                  <geometry>
                      <box><size>${wall_thick} ${wall_width} ${wall_height}</size></box>
                  </geometry>
                  <xacro:paint material="wall"/>
              </visual>
          </link>
      </model>
  </xacro:macro>

  <!-- Runs of n walls. wall_col: east of cells (x, y..y+n-1); wall_row: north of cells (x..x+n-1, y) -->
  <xacro:macro name="wall_col" params="x y n">
    <xacro:if value="${n > 0}">
      <xacro:wall x="${x}" y="${y}" px="0" />
      <xacro:wall_col x="${x}" y="${y+1}" n="${n-1}" />
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="wall_row" params="x y n">
    <xacro:if value="${n > 0}">
      <xacro:wall x="${x}" y="${y}" px="1" />
      <xacro:wall_row x="${x+1}" y="${y}" n="${n-1}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="entry_outer" params="x y px">
    <xacro:wall x="${x}" y="${y+9}"  px="${px}" />
    <xacro:wall x="${x}" y="${y+8}"  px="${px}" />
    <xacro:wall x="${x}" y="${y+7}"  px="${px}" />
    <xacro:wall x="${x}" y="${y+6}"  px="${px}" />
    <xacro:wall x="${x}" y="${y+5}"  px="${px}" />
    <xacro:wall x="${x}" y="${y+4}"  px="${px}" />
    <xacro:wall x="${x}" y="${y+3}"  px="${px}" />
    <xacro:wall x="${x}" y="${y+2}"  px="${px}" />
    <xacro:wall x="${x}" y="${y+1}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-1}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-2}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-3}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-4}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-5}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-6}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-7}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-8}"  px="${px}" />
    <xacro:wall x="${x}" y="${y-9}"  px="${px}" />
  </xacro:macro>

  <xacro:macro name="side_outer" params="x y px">
      <xacro:wall y="${y}" x="${x+9}"  px="${px}" />
      <xacro:wall y="${y}" x="${x+8}"  px="${px}" />
      <xacro:wall y="${y}" x="${x+7}"  px="${px}" />
      <xacro:wall y="${y}" x="${x+6}"  px="${px}" />
      <xacro:wall y="${y}" x="${x+5}"  px="${px}" />
      <xacro:wall y="${y}" x="${x+4}"  px="${px}" />
      <xacro:wall y="${y}" x="${x+3}"  px="${px}" />
      <xacro:wall y="${y}" x="${x+2}"  px="${px}" />
      <xacro:wall y="${y}" x="${x+1}"  px="${px}" />
      <xacro:wall y="${y}" x="${x}"    px="${px}" />
      <xacro:wall y="${y}" x="${x-1}"  px="${px}" />
      <xacro:wall y="${y}" x="${x-2}"  px="${px}" />
      <xacro:wall y="${y}" x="${x-3}"  px="${px}" />
      <xacro:wall y="${y}" x="${x-4}"  px="${px}" />
      <xacro:wall y="${y}" x="${x-5}"  px="${px}" />
      <xacro:wall y="${y}" x="${x-6}"  px="${px}" />
      <xacro:wall y="${y}" x="${x-7}"  px="${px}" />
      <xacro:wall y="${y}" x="${x-8}"  px="${px}" />
      <xacro:wall y="${y}" x="${x-9}"  px="${px}" />
  </xacro:macro>

</sdf>

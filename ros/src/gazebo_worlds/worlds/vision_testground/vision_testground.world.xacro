<?xml version="1.0" ?>
<!--
  xacro version of colored_objects.sdf

  Generate the SDF, then run it in Gazebo:
      xacro colored_objects.sdf.xacro -o colored_objects.sdf
      gz sim -r colored_objects.sdf

  Override any argument from the command line:
      xacro colored_objects.sdf.xacro head_w:=0.08 thick:=0.01 -o colored_objects.sdf

  Layout (seen from the robot at the origin; +X forward, +Y left):
      wall at x = 2.0, three arrows on its face, three 3 cm boxes on the floor in front of it.
-->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="aux_macros.xacro" />
    <xacro:include filename="paredes.xacro" />

    <!-- ===== World ===== -->
    <world name="colored_objects">

        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
            <collision name="collision">
                <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
            </collision>
            <visual name="visual">
                <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
                <material>
                <ambient>0.8 0.8 0.8 1</ambient>
                <diffuse>0.8 0.8 0.8 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>
            </link>
        </model>

        <!-- MEASURES: corridors 40 cm wide, walls 20 cm high, one wall stretch = 32 cm.
             Two curves n stretches apart are 0.32*n + 0.40 m between centers.
             The walls come from generar_paredes.py -->
        <xacro:paredes />

        <!-- START: the robot enters and leaves by the same place -->
        <xacro:zone name="start_marker" x="1.88" y="0" px="${pi}" material="verde" />
        <!-- CONTAINERS: one per cube color, behind the start position -->
        <xacro:container name="rojo"  x="2.43" y="0.25"  material="rojo" />
        <xacro:container name="verde" x="2.43" y="0"     material="verde" />
        <xacro:container name="azul"  x="2.43" y="-0.25" material="azul" />

        <!-- CUBES: each one at the end of a corridor with no exit -->
        <xacro:box name="rojo"  x="-2.80" y="-0.64" material="rojo" />
        <xacro:box name="verde" x="-4.16" y="4.08"  material="verde" />
        <xacro:box name="azul"  x="-1.04" y="-3.20" material="azul" />

        <!-- FORBIDDEN ZONE: 40x40 cm. It closes the west side of the small island.
             The big island stays free to go around it -->
        <xacro:marked_zone name="prohibida_isla_chica" x="-1.56" y="-1.80" />

        <!-- OBSTACLES: fixed blocks against a wall. They leave 20 cm of corridor free -->
        <xacro:obstacle name="1" x="-2.70" y="0.00" />
        <xacro:obstacle name="2" x="-2.70" y="1.72" />
        <xacro:obstacle name="3" x="-4.26" y="3.20" />
        <xacro:obstacle name="4" x="-0.94" y="-2.70" />
        <xacro:obstacle name="5" x="-3.50" y="2.50" />

        <!-- ARROWS: on the wall ahead of a curve. Islands have none.
             close = 1 wall stretch to the next curve, middle = 2, far = 3 or more -->
        <xacro:middle_arrow name="rojo_a" x="0" y="0" px="2" dir="1" material="rojo" />
        <xacro:middle_arrow name="verde_a" x="0" y="0" px="2" dir="1" material="verde" />
        <xacro:close_arrow name="azul_a" x="0" y="0" px="2" dir="-1" material="azul" />
        <xacro:middle_arrow name="azul_b" x="0" y="-0.72" px="3" dir="1" material="azul" />
        <xacro:close_arrow name="azul_c" x="-1.04" y="-0.72" px="2" dir="-1" material="azul" />
        <xacro:close_arrow name="rojo_g" x="0" y="1.04" px="1" dir="-1" material="rojo" />
        <xacro:close_arrow name="verde_g" x="0" y="1.04" px="1" dir="-1" material="verde" />
        <xacro:far_arrow name="rojo_k" x="-2.80" y="1.04" px="2" dir="-1" material="rojo" />
        <xacro:far_arrow name="verde_k" x="-2.80" y="1.04" px="2" dir="1" material="verde" />
        <xacro:far_arrow name="verde_l" x="-2.80" y="2.40" px="1" dir="-1" material="verde" />
        <xacro:far_arrow name="verde_m" x="-4.16" y="2.40" px="2" dir="1" material="verde" />

    </world>
</sdf>

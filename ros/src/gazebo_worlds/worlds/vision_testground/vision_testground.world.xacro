<?xml version="1.0" ?>
<!--
  xacro version of colored_objects.sdf

  Generate the SDF, then run it in Gazebo:
      xacro colored_objects.sdf.xacro -o colored_objects.sdf
      gz sim -r colored_objects.sdf

  Override any argument from the command line:
      xacro colored_objects.sdf.xacro head_w:=0.08 thick:=0.01 -o colored_objects.sdf

  Layout (seen from the robot at the origin; +X forward, +Y left):
      wall at x = 2.0, three arrows on its face, three 3 cm boxes on the floor in front of it.
-->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="aux_macros.xacro" />

    <!-- ===== World ===== -->
    <world name="colored_objects">

        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
            <collision name="collision">
                <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
            </collision>
            <visual name="visual">
                <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
                <material>
                <ambient>0.8 0.8 0.8 1</ambient>
                <diffuse>0.8 0.8 0.8 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>
            </link>
        </model>

        <!-- 3.2,0 START ZONE (GREEN) -->
        <xacro:zone name="start_marker" x="${11*0.32}" y="${0*0.32}" px="${pi}" material="verde" />
        <!-- -3.2,0 END ZONE (BLUE) -->
        <xacro:zone name="end_marker" x="${-11*0.32}" y="${0*0.32}" px="0" material="azul" />
        <!-- OUTER WALL START -->
        <xacro:entry_outer x="9"  y="0" px="${NORTH}" />
        <xacro:side_outer  y="9"  x="0" px="${WEST}" />
        <xacro:side_outer  y="-9"  x="0" px="${EAST}" />
        <xacro:entry_outer x="-9" y="0" px="${SOUTH}" />
        <!-- OUTER WALL END -->

        <!-- INNER WALLS -->
        <xacro:wall_col x="-9" y="-3" n="3" />
        <xacro:wall_col x="-8" y="-2" n="3" />
        <xacro:wall_col x="-3" y="7" n="3" />
        <xacro:wall_col x="-2" y="-2" n="9" />
        <xacro:wall_col x="-1" y="-3" n="8" />
        <xacro:wall_col x="-1" y="6" n="1" />
        <xacro:wall_col x="0" y="-2" n="3" />
        <xacro:wall_col x="0" y="7" n="3" />
        <xacro:wall_col x="1" y="1" n="4" />
        <xacro:wall_col x="2" y="1" n="1" />
        <xacro:wall_col x="2" y="3" n="3" />
        <xacro:wall_col x="3" y="-7" n="3" />
        <xacro:wall_col x="3" y="-2" n="3" />
        <xacro:wall_col x="4" y="-4" n="4" />
        <xacro:wall_col x="5" y="-4" n="3" />
        <xacro:wall_col x="6" y="-7" n="3" />
        <xacro:wall_col x="6" y="0" n="2" />
        <xacro:wall_col x="7" y="-1" n="1" />
        <xacro:wall_col x="7" y="1" n="2" />
        <xacro:wall_row x="4" y="-8" n="3" />
        <xacro:wall_row x="4" y="-5" n="1" />
        <xacro:wall_row x="6" y="-5" n="1" />
        <xacro:wall_row x="-8" y="-4" n="8" />
        <xacro:wall_row x="-7" y="-3" n="6" />
        <xacro:wall_row x="1" y="-3" n="3" />
        <xacro:wall_row x="6" y="-2" n="2" />
        <xacro:wall_row x="-9" y="-1" n="1" />
        <xacro:wall_row x="5" y="-1" n="2" />
        <xacro:wall_row x="8" y="-1" n="2" />
        <xacro:wall_row x="-9" y="0" n="2" />
        <xacro:wall_row x="1" y="0" n="1" />
        <xacro:wall_row x="3" y="0" n="1" />
        <xacro:wall_row x="8" y="0" n="2" />
        <xacro:wall_row x="3" y="1" n="4" />
        <xacro:wall_row x="3" y="2" n="5" />
        <xacro:wall_row x="0" y="4" n="2" />
        <xacro:wall_row x="0" y="5" n="3" />
        <xacro:wall_row x="-2" y="6" n="1" />
        <xacro:wall_row x="0" y="6" n="1" />
        <!-- ISLANDS: one 3x3 room per box -->
        <xacro:box name="rojo" x="${2*wall_width}" y="${-1*wall_width}" material="rojo" />
        <xacro:box name="verde" x="${-1*wall_width}" y="${8*wall_width}" material="verde" />
        <xacro:box name="azul" x="${5*wall_width}" y="${-6*wall_width}" material="azul" />
        <!-- ARROWS: placed on the wall ahead of every curve, one per color whose route turns there -->
        <!-- curve at cell -1,5 -->
        <xacro:far_arrow name="verde_-1_5" x="-1" y="5" px="2" dir="1" material="verde" />
        <!-- curve at cell 2,2 -->
        <xacro:far_arrow name="rojo_2_2" x="2" y="2" px="2" dir="-1" material="rojo" />
        <xacro:far_arrow name="verde_2_2" x="2" y="2" px="2" dir="1" material="verde" />
        <!-- curve at cell 2,5 -->
        <xacro:far_arrow name="verde_2_5" x="2" y="5" px="1" dir="-1" material="verde" />
        <!-- curve at cell 5,-1 -->
        <xacro:far_arrow name="azul_5_-1" x="5" y="-1" px="2" dir="-1" material="azul" />
        <!-- curve at cell 7,-1 -->
        <xacro:middle_arrow name="azul_7_-1" x="7" y="-1" px="3" dir="1" material="azul" />
        <!-- curve at cell 7,0 -->
        <xacro:middle_arrow name="rojo_7_0" x="7" y="0" px="2" dir="1" material="rojo" />
        <xacro:middle_arrow name="verde_7_0" x="7" y="0" px="2" dir="1" material="verde" />
        <xacro:close_arrow name="azul_7_0" x="7" y="0" px="2" dir="-1" material="azul" />
        <!-- curve at cell 7,2 -->
        <xacro:far_arrow name="rojo_7_2" x="7" y="2" px="1" dir="-1" material="rojo" />
        <xacro:far_arrow name="verde_7_2" x="7" y="2" px="1" dir="-1" material="verde" />

    </world>
</sdf>

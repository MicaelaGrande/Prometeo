<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="slam_test_world">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <model name="start_marker">
      <static>true</static>
      <pose>-3.5 3.5 0.012 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.099</radius>
              <length>0.024</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Light defined inline so Gazebo Harmonic does not need model://sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane defined inline so Gazebo Harmonic does not need model://ground_plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="environment">
      <static>true</static>

      <link name="north_wall">
        <pose>0 4.9 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10 0.2 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.2 0.8</size></box></geometry></visual>
      </link>

      <link name="south_wall">
        <pose>0 -4.9 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10 0.2 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 0.2 0.8</size></box></geometry></visual>
      </link>

      <link name="east_wall">
        <pose>4.9 0 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 10 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 0.8</size></box></geometry></visual>
      </link>

      <link name="west_wall">
        <pose>-4.9 0 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 10 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 0.8</size></box></geometry></visual>
      </link>

      <link name="wall_a">
        <pose>-1.8 1.6 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 4.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 4.8 0.8</size></box></geometry></visual>
      </link>

      <link name="wall_b">
        <pose>1.6 -1.5 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 4.6 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 4.6 0.8</size></box></geometry></visual>
      </link>

      <link name="wall_c">
        <pose>0 0.2 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.6 0.2 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.6 0.2 0.8</size></box></geometry></visual>
      </link>

      <link name="box_obstacle">
        <pose>3.2 2.7 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></visual>
      </link>

      <link name="cylinder_obstacle">
        <pose>-3.3 -2.7 0.5 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.45</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.45</radius><length>1.0</length></cylinder></geometry></visual>
      </link>

      <link name="small_box">
        <pose>3.4 -3.3 0.35 0 0 0.4</pose>
        <collision name="collision"><geometry><box><size>1.3 0.6 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.3 0.6 0.7</size></box></geometry></visual>
      </link>
    </model>

  </world>
</sdf>

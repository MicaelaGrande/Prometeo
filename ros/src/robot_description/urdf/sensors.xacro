<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- HC-SR04 simulado. Gazebo no trae sensor de ultrasonido: se pide un abanico de
         rayos (gpu_lidar, +-15 grados) que cubre el cono del sensor. El nodo
         hcsr04_sim (prometeo_sensores) los convierte en lo que mediria el real.
         Link y topic conservan los nombres en espanol (frente/izq/der) porque los
         usan hcsr04_sim y distancias_a_range.
         roll/yaw orientan la plaquita (eje x = hacia donde mide).
         fan_roll endereza el abanico en los laterales, que estan girados. -->
    <xacro:macro name="ultrasonic" params="name x y z roll yaw fan_roll">
      <link name="ultrasonido_${name}_link">
        <visual>
          <geometry>
            <box size="${us_depth} ${us_width} ${us_height}"/>
          </geometry>
          <material name="silver"/>
        </visual>
      </link>

      <joint name="ultrasonido_${name}_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonido_${name}_link"/>
        <origin xyz="${x} ${y} ${z}" rpy="${roll} 0 ${yaw}"/>
      </joint>

      <gazebo reference="ultrasonido_${name}_link">
        <sensor name="ultrasonido_${name}" type="gpu_lidar">
          <pose>0 0 0 ${fan_roll} 0 0</pose>
          <topic>/ultrasonido/${name}/rayos</topic>
          <update_rate>20</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>21</samples>
                <resolution>1</resolution>
                <min_angle>${-15 * pi / 180}</min_angle>
                <max_angle>${15 * pi / 180}</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.01</min>
              <max>4.5</max>
              <resolution>0.001</resolution>
            </range>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:macro>

    <xacro:macro
        name="sensors"
    >
    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.05</near><far>10</far></clip>
        </camera>
      </sensor>
    </gazebo>
    </xacro:macro>
</robot>

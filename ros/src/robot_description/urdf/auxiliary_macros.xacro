<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ============================================================================== -->
<!-- Macros Visuales Mesh                                                           -->
<!-- ============================================================================== -->

    <!-- Link tipo caja -->
    <xacro:macro
        name="mesh_link"
        params="mesh scale material xyz rpy"
    >
        <visual>
            <origin xyz="${xyz}" rpy="${rpy}" />
            <geometry>
                <mesh
                    filename="package://$(arg package_name)/$(arg mesh_dir)/${mesh}"
                    scale="${scale}"
                />
            </geometry>
            <material name="${material}" />
        </visual>
    </xacro:macro>

    <!-- Visual con formas simples -->
    <xacro:macro name="box_visual" params="x y z material xyz rpy:='0 0 0'">
        <visual>
            <origin xyz="${xyz}" rpy="${rpy}" />
            <geometry>
                <box size="${x} ${y} ${z}"/>
            </geometry>
            <material name="${material}" />
        </visual>
    </xacro:macro>

    <xacro:macro name="cylinder_visual" params="radius height material xyz rpy:='0 0 0'">
        <visual>
            <origin xyz="${xyz}" rpy="${rpy}" />
            <geometry>
                <cylinder radius="${radius}" length="${height}"/>
            </geometry>
            <material name="${material}" />
        </visual>
    </xacro:macro>

<!-- ============================================================================== -->
<!-- Macros Colisiones                                                              -->
<!-- ============================================================================== -->

    <xacro:macro
        name="box_collision"
        params="x y z xyz rpy"
    >
        <collision>
            <geometry>
                <box size="${x} ${y} ${z}"/>
            </geometry>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </collision>
    </xacro:macro>

    <xacro:macro
        name="sphere_collision"
        params="radius xyz rpy"
    >
        <collision>
            <geometry>
            <sphere radius="${radius}"/>
            </geometry>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </collision>
    </xacro:macro>

    <xacro:macro
        name="cylinder_collision"
        params="radius height xyz rpy"
    >
        <collision>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <geometry>
                <cylinder radius="${radius}" length="${height}"/>
            </geometry>
        </collision>
    </xacro:macro>

<!-- ============================================================================== -->
<!-- Macros Inerciales                                                              -->
<!-- ============================================================================== -->

    <xacro:macro
        name="box_inertia"
        params="mass x y z xyz rpy"
    >
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <inertia
                ixx="${(mass/12.0) * (y*y + z*z)}" ixy="0" ixz="0"
                iyy="${(mass/12.0) * (x*x + z*z)}" iyz="0"
                izz="${(mass/12.0) * (x*x + y*y)}"
            >
            </inertia>
        </inertial>
    </xacro:macro>

    <xacro:macro
        name="sphere_inertia"
        params="mass radius xyz rpy"
    >
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
                <inertia
                    ixx="${(2.0/5.0) * mass * radius * radius}"     ixy="0.0"     ixz="0.0"
                    iyy="${(2.0/5.0) * mass * radius * radius}"     iyz="0.0"
                    izz="${(2.0/5.0) * mass * radius * radius}"
                />
        </inertial>
    </xacro:macro>

    <xacro:macro
        name="cylinder_inertia"
        params="mass radius height xyz rpy"
    >
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <inertia
                ixx="${(mass/12.0) * (3*radius*radius + height*height)}" ixy="0" ixz="0"
                iyy="${(mass/12.0) * (3*radius*radius + height*height)}" iyz="0"
                izz="${(mass/2.0) * (radius*radius)}"
            >
            </inertia>
        </inertial>
    </xacro:macro>

<!-- ============================================================================== -->
<!-- Macros de Partes                                                               -->
<!-- ============================================================================== -->


    <!-- offset la malla nace en una cara de la rueda; lo corre medio ancho (+ izquierda, - derecha)
         para que gire sobre su centro. El link queda con el eje de giro en y, como en prometeo_description. -->
    <xacro:macro name="wheel" params="name mesh xyz offset">
        <link name="${name}_link">
            <xacro:mesh_link
                mesh="${mesh}" scale="${wheel_scale}"
                material="negro"
                xyz="0 ${offset} 0" rpy="${-pi/2} 0 0"
            />
            <xacro:cylinder_collision
                radius="${wheel_radius}" height="${wheel_thickness}"
                xyz="0 0 0" rpy="${-pi/2} 0 0"
            />
            <!-- cilindro con el eje de giro en y -->
            <inertial>
                <mass value="${wheel_mass}"/>
                <inertia
                    ixx="${wheel_mass * (3*wheel_radius**2 + wheel_thickness**2) / 12}" ixy="0" ixz="0"
                    iyy="${wheel_mass * wheel_radius**2 / 2}" iyz="0"
                    izz="${wheel_mass * (3*wheel_radius**2 + wheel_thickness**2) / 12}"
                />
            </inertial>
        </link>
        <joint name="${name}_joint" type="continuous">
          <parent link="base_link"/>
          <child link="${name}_link"/>
          <origin xyz="${xyz}"/>

          <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

</robot>

<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ============================================================================== -->
<!-- Macros Visuales Mesh                                                           -->
<!-- ============================================================================== -->

    <!-- Link tipo caja -->
    <xacro:macro
        name="mesh_link"
        params="mesh scale material xyz rpy"
    >
        <visual>
            <origin xyz="${xyz}" rpy="${rpy}" />
            <geometry>
                <mesh
                    filename="package://$(arg package_name)/$(arg mesh_dir)/${mesh}"
                    scale="${scale}"
                />
            </geometry>
            <material name="${material}" />
        </visual>
    </xacro:macro>

<!-- ============================================================================== -->
<!-- Macros Colisiones                                                              -->
<!-- ============================================================================== -->

    <xacro:macro
        name="box_collision"
        params="x y z xyz rpy"
    >
        <collision>
            <geometry>
                <box size="${x} ${y} ${z}"/>
            </geometry>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </collision>
    </xacro:macro>

    <xacro:macro
        name="sphere_collision"
        params="radius xyz rpy"
    >
        <collision>
            <geometry>
            <sphere radius="${radius}"/>
            </geometry>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </collision>
    </xacro:macro>

    <xacro:macro
        name="cylinder_collision"
        params="radius height xyz rpy"
    >
        <collision>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <geometry>
                <cylinder radius="${radius}" length="${height}"/>
            </geometry>
        </collision>
    </xacro:macro>

<!-- ============================================================================== -->
<!-- Macros Inerciales                                                              -->
<!-- ============================================================================== -->

    <xacro:macro
        name="box_inertia"
        params="mass x y z xyz rpy"
    >
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <inertia
                ixx="${(mass/12.0) * (y*y + z*z)}" ixy="0" ixz="0"
                iyy="${(mass/12.0) * (x*x + z*z)}" iyz="0"
                izz="${(mass/12.0) * (x*x + y*y)}"
            >
            </inertia>
        </inertial>
    </xacro:macro>

    <xacro:macro
        name="sphere_inertia"
        params="mass radius o_xyz o_rpy"
    >
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
                <inertia
                    ixx="${(2.0/5.0) * mass * radius * radius}"     ixy="0.0"     ixz="0.0"
                    iyy="${(2.0/5.0) * mass * radius * radius}"     iyz="0.0"
                    izz="${(2.0/5.0) * mass * radius * radius}"
                />
        </inertial>
    </xacro:macro>

    <xacro:macro
        name="cylinder_inertia"
        params="mass radius height xyz rpy"
    >
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <inertia
                ixx="${(mass/12.0) * (3*radius*radius + height*height)}" ixy="0" ixz="0"
                iyy="${(mass/12.0) * (3*radius*radius + height*height)}" iyz="0"
                izz="${(mass/2.0) * (radius*radius)}"
            >
            </inertia>
        </inertial>
    </xacro:macro>

</robot>

<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ======================================================================= -->
<!-- ======================================================================= -->

    <link name="base_footprint" />

    <link name="base_link">
        <xacro:mesh_link
                mesh="${base_mesh}" scale="${base_scale}"
                material="acrilico"
                xyz="${base_visual_xyz}"    rpy="${base_visual_rpy}"
            />
        <xacro:box_collision
                x="${robot_length}" y="${robot_width}" z="${robot_height}"
                xyz="0 0 ${robot_height/2}"   rpy="0 0 0"
        />
        <xacro:box_inertia
            mass="${base_mass}"
            x="${robot_length}" y="${robot_width}" z="${robot_height}"
            xyz="0 0 ${robot_height/2}"   rpy="0 0 0"
        />
    </link>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius - axis_height}" rpy="0 0 0" />
    </joint>

    <link name="top_plate_link">
        <xacro:mesh_link
                mesh="${base_mesh}" scale="${base_scale}"
                material="acrilico"
                xyz="0 0 0"    rpy="0 0 0"
            />
    </link>
    <joint name="top_plate_joint" type="fixed">
        <parent link="base_link" />
        <child link="top_plate_link" />
        <origin xyz="0 0 ${top_plate_z}" rpy="0 0 0" />
    </joint>

    <link name="front_plate_link">
        <xacro:mesh_link
                mesh="${front_plate_mesh}" scale="${plate_scale}"
                material="gris"
                xyz="0 0 0"    rpy="0 0 0"
            />
    </link>
    <joint name="front_plate_joint" type="fixed">
        <parent link="base_link" />
        <child link="front_plate_link" />
        <origin xyz="${front_plate_xyz}" rpy="${front_plate_rpy}" />
    </joint>

    <link name="back_plate_link">
        <xacro:mesh_link
                mesh="${back_plate_mesh}" scale="${plate_scale}"
                material="gris"
                xyz="0 0 0"    rpy="0 0 0"
            />
    </link>
    <joint name="back_plate_joint" type="fixed">
        <parent link="base_link" />
        <child link="back_plate_link" />
        <origin xyz="${back_plate_xyz}" rpy="${back_plate_rpy}" />
    </joint>

    <!-- Wheels -->
    <xacro:wheel name="left_front_wheel" mesh="${left_wheel_mesh}"
        xyz="${front_axis} ${left_axis} ${axis_height}" offset="${wheel_thickness/2}"
    />
    <xacro:wheel name="left_back_wheel" mesh="${left_wheel_mesh}"
        xyz="${back_axis} ${left_axis} ${axis_height}" offset="${wheel_thickness/2}"
    />
    <xacro:wheel name="right_front_wheel" mesh="${right_wheel_mesh}"
        xyz="${front_axis} ${right_axis} ${axis_height}" offset="${-wheel_thickness/2}"
    />
    <xacro:wheel name="right_back_wheel" mesh="${right_wheel_mesh}"
        xyz="${back_axis} ${right_axis} ${axis_height}" offset="${-wheel_thickness/2}"
    />

<!-- ======================================================================== -->
<!-- ================================ Sensors =============================== -->
<!-- ======================================================================== -->

<!-- 1 ESP32-CAM sobre el servo de giro (camera_servo.xacro) -->
<xacro:esp32_cam name="camera" parent="camera_pan_link" x="0.025" y="0" z="${bracket_height + 0.04/2}"/>

<!-- 3 HC-SR04 en el parachoques delantero frente, izquierda y derecha -->
<xacro:ultrasonic name="frente" x="${us_body_length/2}" y="0" z="${us_front_z}"
                  roll="0" yaw="0" fan_roll="0"/>
<xacro:ultrasonic name="izq" x="${us_side_x}" y="${us_body_width/2}" z="${us_side_z}"
                  roll="${pi/2}" yaw="${pi/2}" fan_roll="${-pi/2}"/>
<xacro:ultrasonic name="der" x="${us_side_x}" y="${-us_body_width/2}" z="${us_side_z}"
                  roll="${pi/2}" yaw="${-pi/2}" fan_roll="${-pi/2}"/>

 <!-- ======================================================================== -->
 <!-- ================================= Misc ================================= -->
 <!-- ======================================================================== -->

<!-- Sensores del robot -->
 <xacro:sensors/>
<!-- Settings Gazebo -->
 <xacro:gazebo/>

</robot>

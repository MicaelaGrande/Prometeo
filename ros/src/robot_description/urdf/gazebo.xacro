<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="gazebo">

    <!-- Plugin de tracción diferencial -->
    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

            <left_joint>left_front_wheel_joint</left_joint>
            <left_joint>left_back_wheel_joint</left_joint>
            <right_joint>right_front_wheel_joint</right_joint>
            <right_joint>right_back_wheel_joint</right_joint>

            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>

            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>

            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>

            <odom_publish_frequency>50</odom_publish_frequency>

            <max_linear_acceleration>1.0</max_linear_acceleration>
            <max_angular_acceleration>2.0</max_angular_acceleration>
        </plugin>

        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"
            >
            <topic>/joint_states</topic>
        </plugin>

    </gazebo>

    <xacro:macro name="wheel_grip" params="name">
        <gazebo reference="${name}_link">
            <mu1>0.8</mu1>
            <mu2>0.8</mu2>
        </gazebo>
    </xacro:macro>
    <xacro:wheel_grip name="left_front_wheel"/>
    <xacro:wheel_grip name="left_back_wheel"/>
    <xacro:wheel_grip name="right_front_wheel"/>
    <xacro:wheel_grip name="right_back_wheel"/>

    <!-- Controlador de posicion de una articulacion. Recibe el angulo en radianes por el topic -->
    <xacro:macro name="position_controller" params="joint topic p d effort i:=0.0">
        <gazebo>
            <plugin
                filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
                <joint_name>${joint}</joint_name>
                <topic>${topic}</topic>
                <p_gain>${p}</p_gain>
                <i_gain>${i}</i_gain>
                <i_max>${effort}</i_max>
                <i_min>${-effort}</i_min>
                <d_gain>${d}</d_gain>
                <cmd_max>${effort}</cmd_max>
                <cmd_min>${-effort}</cmd_min>
            </plugin>
        </gazebo>
    </xacro:macro>

    <!-- Servo de la camara y brazo. Las articulaciones pasivas (compensacion y muneca) tambien
         reciben su angulo, calculado por el nodo arm_teleop, para no depender del mimic -->
    <xacro:position_controller joint="camera_pan_joint" topic="/camera/pan/cmd_pos" p="0.05" d="0.002" effort="0.2"/>
    <xacro:position_controller joint="arm_base_yaw_joint" topic="/arm/base_yaw/cmd_pos" p="2.0" d="0.1" effort="1.0"/>
    <xacro:position_controller joint="arm_shoulder_joint" topic="/arm/shoulder/cmd_pos" p="40.0" d="1.2" i="8.0" effort="3.0"/>
    <xacro:position_controller joint="arm_elbow_joint" topic="/arm/elbow/cmd_pos" p="25.0" d="5.0" i="20.0" effort="3.0"/>
    <xacro:position_controller joint="arm_elbow_compensation_joint" topic="/arm/elbow_compensation/cmd_pos" p="50.0" d="1.0" i="20.0" effort="3.0"/>
    <xacro:position_controller joint="arm_wrist_elbow_joint" topic="/arm/wrist/cmd_pos" p="2.0" d="0.02" i="0.2" effort="0.5"/>
    <xacro:position_controller joint="gripper_joint" topic="/arm/gripper/cmd_pos" p="0.2" d="0.005" effort="0.2"/>
    <xacro:position_controller joint="gripper_right_joint" topic="/arm/gripper_right/cmd_pos" p="0.2" d="0.005" effort="0.2"/>

    </xacro:macro>

</robot>

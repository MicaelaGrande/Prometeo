<?xml version="1.0"?>
<!--
  Servo que gira la ESP32-CAM (de izquierda a derecha, 180 grados como el MG90S).
  Todo son cajas con las medidas de los STL del subconjunto de camara y del MG90S (en metros).
  La camara (camera_link, en mobile_base.xacro) cuelga del link que gira.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="servo_x" value="0.075"/>          <!-- centro del servo, adelante del brazo -->
  <xacro:property name="holder_height" value="0.017"/>    <!-- soporte 40 x 23 x 17 mm, el largo a lo ancho del robot -->
  <xacro:property name="servo_size_x" value="0.0122"/>    <!-- MG90S 22.8 x 12.2 x 22.5 mm -->
  <xacro:property name="servo_size_y" value="0.0228"/>
  <xacro:property name="servo_size_z" value="0.0225"/>
  <xacro:property name="bracket_height" value="0.012"/>   <!-- soporte de la camara 69 x 27 x 12 mm -->

  <link name="camera_servo_link">
    <xacro:box_visual x="0.023" y="0.04" z="${holder_height}" material="gris"
                      xyz="0 0 ${holder_height/2}"/>
    <xacro:box_visual x="${servo_size_x}" y="${servo_size_y}" z="${servo_size_z}" material="azul"
                      xyz="0 0 ${holder_height + servo_size_z/2}"/>
    <xacro:box_collision x="0.023" y="0.04" z="${holder_height + servo_size_z}"
                         xyz="0 0 ${(holder_height + servo_size_z)/2}" rpy="0 0 0"/>
    <xacro:box_inertia mass="0.03" x="0.023" y="0.04" z="${holder_height + servo_size_z}"
                       xyz="0 0 ${(holder_height + servo_size_z)/2}" rpy="0 0 0"/>
  </link>
  <joint name="camera_servo_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_servo_link"/>
    <origin xyz="${servo_x} 0 ${robot_height + plate_thickness}"/>
  </joint>

  <!-- Parte que gira con el servo el soporte de la camara -->
  <link name="camera_pan_link">
    <xacro:box_visual x="0.069" y="0.027" z="${bracket_height}" material="gris"
                      xyz="0 0 ${bracket_height/2}"/>
    <xacro:box_inertia mass="0.02" x="0.069" y="0.027" z="${bracket_height}"
                       xyz="0 0 ${bracket_height/2}" rpy="0 0 0"/>
  </link>
  <joint name="camera_pan_joint" type="revolute">
    <parent link="camera_servo_link"/>
    <child link="camera_pan_link"/>
    <origin xyz="0 0 ${holder_height + servo_size_z}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="0.2" velocity="3.0"/>
    <dynamics damping="0.05" friction="0.2"/>
  </joint>

</robot>

<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Donde estan las mallas la ruta es package_name, mesh_dir y archivo -->
    <xacro:arg name="package_name" default="robot_description" />
    <xacro:arg name="mesh_dir" default="meshes" />

    <!-- Colores. Definidos una vez para poder usarlos en todas las piezas.
         El orden es rojo, verde, azul y opacidad, de 0 a 1. -->
    <material name="negro">
      <color rgba="0.1 0.1 0.1 1"/>
    </material>
    <material name="gris">
      <color rgba="0.3 0.3 0.33 1"/>
    </material>
    <material name="acrilico">
      <color rgba="0.8 0.85 0.9 0.5"/>
    </material>
    <material name="plateado">
      <color rgba="0.75 0.75 0.75 1"/>
    </material>
    <material name="azul">
      <color rgba="0.1 0.3 0.8 1"/>
    </material>

    <!-- Escala global del modelo CAD exportado desde SolidWorks -->
    <xacro:property name="global_scale" value="1.0" />
    <xacro:property
        name="base_scale"
        value="${global_scale} ${global_scale} ${global_scale}"
    />
    <xacro:property
        name="plate_scale"
        value="${global_scale} ${global_scale} ${global_scale}"
    />
    <xacro:property
        name="wheel_scale"
        value="${global_scale} ${global_scale} ${global_scale}"
    />
<!-- =========================================================== -->

    <!-- Cuerpo (mismas medidas que prometeo_description). length = x, width = y, height = z -->
    <xacro:property name="robot_length" value="0.26" />
    <xacro:property name="robot_width" value="0.163" />
    <xacro:property name="robot_height" value="0.056" />
    <xacro:property name="plate_thickness" value="0.004" />

    <!-- Base -->
    <xacro:property name="base_mesh" value="base.STL" />
    <xacro:property name="base_mass" value="0.9" />

    <xacro:property name="base_visual_xyz" value="0 0 0" />
    <xacro:property name="base_visual_rpy" value="0 0 0" />

    <!-- Top plate (mismo modelo que la base, apoyada sobre los parachoques) -->
    <xacro:property name="top_plate_z" value="${robot_height + plate_thickness/2}" />

    <!-- HC-SR04 (ultrasonido). Medidas en metros -->
    <xacro:property name="us_depth" value="0.015" />
    <xacro:property name="us_width" value="0.045" />
    <xacro:property name="us_height" value="0.02" />
    <xacro:property name="us_body_length" value="${robot_length}" />   <!-- de punta a punta -->
    <xacro:property name="us_body_width" value="${robot_width}" />   <!-- ancho de los parachoques -->
    <xacro:property name="us_side_x" value="0.10" />        <!-- agujeros laterales del parachoques -->
    <xacro:property name="us_side_z" value="0.028" />
    <xacro:property name="us_front_z" value="0.037" />

    <!-- Front Plate -->
    <xacro:property name="front_plate_mesh" value="front_plate.STL" />
    <xacro:property name="back_plate_mesh" value="back_plate.STL" />

    <xacro:property name="front_plate_xyz" value="0.135 -0.085 0" />
    <xacro:property name="back_plate_xyz" value="-0.137 0.09 0" />
    <xacro:property name="front_plate_rpy" value="0 0 ${pi/2}" />
    <xacro:property name="back_plate_rpy" value="0 0 ${-pi/2}" />
    <xacro:property name="front_plate_coll_xyz" value="0.083750 0.020398 0.024938" />
    <xacro:property name="back_plate_coll_xyz"  value="0.083750 0.020398 0.024938" />
    <xacro:property name="plate_width" value="0.163" />
    <xacro:property name="plate_depth" value="0.0468" />
    <xacro:property name="plate_height" value="0.056" />
    <xacro:property name="plate_mass" value="0.25" />

<!-- =========================================================== -->
<!-- Wheels -->
<!-- =========================================================== -->

    <xacro:property name="wheel_radius" value="0.0345"/>
    <xacro:property name="wheel_thickness" value="0.03"/>   <!-- ancho de la rueda, a lo largo del eje -->
    <xacro:property name="wheel_mass" value="0.08" />

    <!-- El eje esta eje_bajo_placa mas abajo que base_link, y las ruedas a +-separacion/2 -->
    <xacro:property name="axis_height" value="-0.01375" />
    <xacro:property name="wheel_separation" value="0.13" />
    <xacro:property name="wheel_base" value="0.111" />       <!-- entre ejes, adelante a atras -->
    <xacro:property name="left_axis" value="${wheel_separation/2}" />
    <xacro:property name="right_axis" value="${-wheel_separation/2}" />
    <xacro:property name="front_axis" value="${wheel_base/2}" />
    <xacro:property name="back_axis" value="${-wheel_base/2}" />

    <xacro:property name="left_wheel_mesh" value="left_wheel.STL" />
    <xacro:property name="right_wheel_mesh" value="right_wheel.STL" />

</robot>

# Lo que pide Decision
# Acciones (constantes: en el codigo, Mover.Goal.IR_A_SALIDA y Mover.Goal.ACERCARSE)
string IR_A_SALIDA="ir_a_salida"
string ACERCARSE="acercarse"
string accion          # IR_A_SALIDA o ACERCARSE
# Salida especial, ademas de las de Lugar: dar media vuelta (callejon)
string VUELTA="vuelta"
string salida          # Lugar.IZQUIERDA, Lugar.ADELANTE, Lugar.DERECHA o VUELTA (solo IR_A_SALIDA)
string length_class    # largo de la flecha (close, normal o far), si hay
---
# Lo que contesta Navegacion cuando termina (Mover.Result.TERMINADA, etc.)
string TERMINADA="terminada"
string BLOQUEADA="bloqueada"
string CANCELADA="cancelada"
string resultado       # TERMINADA, BLOQUEADA o CANCELADA

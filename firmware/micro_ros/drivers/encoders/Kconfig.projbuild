# Opciones de la libreria de encoders (encoder.c).
menu "Prometeo - Encoders"

    comment "== Pines =="

    config PROMETEO_ENCODER_DEL_DER_PIN
        int "Encoder rueda delantera derecha - pin"
        range 0 39
        default 5

    config PROMETEO_ENCODER_DEL_IZQ_PIN
        int "Encoder rueda delantera izquierda - pin"
        range 0 39
        default 2

    config PROMETEO_ENCODER_TRAS_DER_PIN
        int "Encoder rueda trasera derecha - pin"
        range 0 39
        default 14

    config PROMETEO_ENCODER_TRAS_IZQ_PIN
        int "Encoder rueda trasera izquierda - pin"
        range 0 39
        default 13

    comment "== Rueda =="

    config PROMETEO_DIAMETRO_RUEDA_MM
        int "Diametro de la rueda (mm)"
        range 10 500
        default 65

    comment "== Misc =="

    config PROMETEO_ENC_FLACOS
        int "Conteo de Flancos por pulso"
        range 1 2
        default 2
        help
            Flancos que se cuentan por pulso: 1 = solo subida, 2 = tambien bajada.
            Con 2 hay el doble de cuentas por vuelta (mas resolucion).
            Puede introducir errores en el conteo.

    config PROMETEO_ENC_PPR
        int "Numero de ranuras del disco"
        range 0 100
        default 20
        help
            Pulsos por revolucion

endmenu

# Opciones de la libreria de motores (motores.c). Los pines de los encoders y el diametro de
# la rueda estan en drivers/encoders/Kconfig.projbuild.
menu "Prometeo - Pines de motores"

    comment "======== Placa Motor ========"

    comment "== Delantero Izquierdo (motor A) =="

    config PROMETEO_MOTOR_A1_PIN
        int "Motor A (delantero izquierdo) - pin IA"
        range 0 33
        default 21

    config PROMETEO_MOTOR_A2_PIN
        int "Motor A (delantero izquierdo) - pin IB"
        range 0 33
        default 22

    comment "== Trasero Izquierdo (motor B) =="

    config PROMETEO_MOTOR_B1_PIN
        int "Motor B (trasero izquierdo) - pin IA"
        range 0 33
        default 16

    config PROMETEO_MOTOR_B2_PIN
        int "Motor B (trasero izquierdo) - pin IB"
        range 0 33
        default 23

    comment "== Delantero Derecho (motor C) =="

    config PROMETEO_MOTOR_C1_PIN
        int "Motor C (delantero derecho) - pin IA"
        range 0 33
        default 18

    config PROMETEO_MOTOR_C2_PIN
        int "Motor C (delantero derecho) - pin IB"
        range 0 33
        default 19

    comment "== Trasero Derecho (motor D) =="

    config PROMETEO_MOTOR_D1_PIN
        int "Motor D (trasero derecho) - pin IA"
        range 0 33
        default 17

    config PROMETEO_MOTOR_D2_PIN
        int "Motor D (trasero derecho) - pin IB"
        range 0 33
        default 25

endmenu

menu "Prometeo - PWM"

    config PROMETEO_PWM_FREQ_HZ
        int "Frecuencia del PWM (Hz)"
        range 100 20000
        default 10000
        help
            Frecuencia del PWM de los motores. Mas alta = mas silencioso, pero menos torque.
            Mas baja = mas torque, pero mas ruido y vibracion. Ajustar segun el driver de potencia.

    config PROMETEO_PWM_RES_BIT
        int "Resolucion del PWM (bits)"
        range 1 16
        default 10
        help
            Resolucion del PWM de los motores. Mas bits = mas preciso, pero menos torque.

endmenu

menu "Prometeo - Cinematica"

    config PROMETEO_RAMP_TIME_MS
        int "Tiempo de rampa de velocidad (ms)"
        range 0 10000
        default 1000
        help
            Tiempo de rampa de velocidad (ms). Al llamar a la funcion aplicar() este es el tiempo que tarda en llegar a la velocidad objetivo.

    config PROMETEO_RAMP_STEP
        int "Step de rampa de velocidad (0 a 2^PWM_RES_BIT - 1 )"
        range 0 255
        default 40
        help
            Step maximo de rampa de velocidad (0 a 2^PWM_RES_BIT - 1 ).
            Al llamar a la funcion aplicar() este es el maximo cambio permitido.

endmenu

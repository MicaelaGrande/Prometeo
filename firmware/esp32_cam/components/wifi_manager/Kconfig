menu "Prometeo Wi-Fi (hotspot de la camara)"

    config PROMETEO_WIFI_SSID
        string "Nombre del hotspot que crea la camara"
        default "prometeo"

    config PROMETEO_WIFI_PASSWORD
        string "Contrasena del hotspot (minimo 8 caracteres, o vacia = red abierta)"
        default "prometeo123"

    config PROMETEO_WIFI_CHANNEL
        int "Canal Wi-Fi (1-13)"
        range 1 13
        default 6

    config PROMETEO_WIFI_MAX_CLIENTES
        int "Maximo de clientes conectados (micro-ROS, la compu, ...)"
        range 1 10
        default 4

    config PROMETEO_WIFI_TX_POWER_DBM
        int "Potencia de transmision del hotspot (dBm)"
        range 2 20
        default 10
        help
            Menos potencia = picos de corriente mas chicos. Con la fuente del robot justa,
            los picos del Wi-Fi bajan la tension y pueden reiniciar la placa. A 10 dBm
            sobra para unos metros; si el cuerpo o la PC estan lejos, subirla (maximo 20).

endmenu

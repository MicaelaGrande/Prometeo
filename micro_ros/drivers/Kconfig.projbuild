menu "Prometeo - Pines GPIO"

    comment "======== Concentrador Delantero ========"

    comment "== Sensores HC-SR04 =="

    config PROMETEO_SENSOR_TRIG_PIN
        int "Sensores (izq, der, frente) - pin TRIG compartido"
        range 0 33
        default 4

    config PROMETEO_SENSOR_IZQ_ECHO_PIN
        int "Sensor izquierdo - pin ECHO"
        range 0 39
        default 32

    config PROMETEO_SENSOR_DER_ECHO_PIN
        int "Sensor derecho - pin ECHO"
        range 0 39
        default 34

    config PROMETEO_SENSOR_FRENTE_ECHO_PIN
        int "Sensor frontal - pin ECHO"
        range 0 39
        default 35

    comment "== Encoders =="

    config PROMETEO_ENCODER_DEL_DER_PIN
        int "Encoder rueda delantera derecha - pin"
        range 0 39
        default 5

    config PROMETEO_ENCODER_DEL_IZQ_PIN
        int "Encoder rueda delantera izquierda - pin"
        range 0 39
        default 2

    config PROMETEO_ENCODER_TRAS_DER_PIN
        int "Encoder rueda trasera derecha - pin"
        range 0 39
        default 14

    config PROMETEO_ENCODER_TRAS_IZQ_PIN
        int "Encoder rueda trasera izquierda - pin"
        range 0 39
        default 13

    comment "======== Control Brazo ========"

    config PROMETEO_SERVO_1_PIN
        int "Servo 1 (camara) - pin"
        range 0 33
        default 0

    config PROMETEO_SERVO_2_PIN
        int "Servo 2 (base) - pin"
        range 0 33
        default 33

    config PROMETEO_SERVO_3_PIN
        int "Servo 3 (hombro) - pin"
        range 0 33
        default 26

    config PROMETEO_SERVO_4_PIN
        int "Servo 4 (codo) - pin"
        range 0 33
        default 27

    config PROMETEO_SERVO_5_PIN
        int "Servo 5 (garra) - pin"
        range 0 33
        default 12

    comment "======== Camara ========"

    config PROMETEO_CAMARA_UART_TX_PIN
        int "Camara UART - pin TX"
        range 0 33
        default 1

    config PROMETEO_CAMARA_UART_RX_PIN
        int "Camara UART - pin RX"
        range 0 33
        default 3

    comment "======== Placa Motor ========"

    comment "== Delantero Izquierdo (motor A) =="

    config PROMETEO_MOTOR_A1_PIN
        int "Motor A (delantero izquierdo) - pin IA"
        range 0 39
        default 21

    config PROMETEO_MOTOR_A2_PIN
        int "Motor A (delantero izquierdo) - pin IB"
        range 0 39
        default 22

    comment "== Trasero Izquierdo (motor B) =="

    config PROMETEO_MOTOR_B1_PIN
        int "Motor B (trasero izquierdo) - pin IA"
        range 0 39
        default 16

    config PROMETEO_MOTOR_B2_PIN
        int "Motor B (trasero izquierdo) - pin IB"
        range 0 39
        default 23

    comment "== Delantero Derecho (motor C) =="

    config PROMETEO_MOTOR_C1_PIN
        int "Motor C (delantero derecho) - pin IA"
        range 0 39
        default 18

    config PROMETEO_MOTOR_C2_PIN
        int "Motor C (delantero derecho) - pin IB"
        range 0 39
        default 19

    comment "== Trasero Derecho (motor D) =="

    config PROMETEO_MOTOR_D1_PIN
        int "Motor D (trasero derecho) - pin IA"
        range 0 39
        default 17

    config PROMETEO_MOTOR_D2_PIN
        int "Motor D (trasero derecho) - pin IB"
        range 0 39
        default 25

endmenu

menu "Prometeo - Cinematica"

    config PROMETEO_WHEEL_SEPARATION_MM
        int "Separacion entre ruedas izq/der (mm)"
        range 50 1000
        default 161
        help
            Distancia entre el centro de las ruedas izquierdas y derechas
            (URDF: wheel_separation = 0.1605 m).

    config PROMETEO_VEL_MAX_MM_S
        int "Velocidad lineal con motores al 100% (mm/s)"
        range 50 5000
        default 700
        help
            Velocidad del robot en linea recta a duty 1.0. ESTIMADO: medir
            cronometrando cuanto tarda en recorrer 1 m a fondo.
            Tambien la usa el freno de emergencia (seguridad.c).

    config PROMETEO_TURN_FACTOR_PCT
        int "Factor de giro skid-steer (%)"
        range 50 500
        default 100
        help
            Multiplica la separacion entre ruedas para girar. Con 4 ruedas sin
            direccion las ruedas patinan al girar y el ancho efectivo es mayor
            que el real (tipico 150-250%). Ajustar girando en el lugar a una
            velocidad angular conocida: si gira de menos, bajar el factor.

endmenu

menu "Prometeo - Test de motores"

    config PROMETEO_BUILD_MOTOR_TEST
        bool "Compilar el firmware de TEST DE MOTORES (en vez del normal)"
        default n
        help
            Compila main/main_test_motores.c: recorre los 4 motores (adelante y atras),
            publica su estado por micro-ROS y acepta comandos. No inicia servos ni
            sensores. Para volver al firmware normal, desactivar esta opcion.

    config PROMETEO_TEST_AUTOSTART
        bool "Arrancar el ciclo solo, unos segundos despues de iniciar"
        depends on PROMETEO_BUILD_MOTOR_TEST
        default n
        help
            Si esta desactivado el test arranca en pausa y espera el comando "auto".

    config PROMETEO_TEST_AUTOSTART_DELAY_S
        int "Segundos de espera antes de arrancar solo"
        depends on PROMETEO_TEST_AUTOSTART
        range 1 60
        default 10

    config PROMETEO_TEST_DUTY_MAX_PCT
        int "Potencia maxima del test (%)"
        depends on PROMETEO_BUILD_MOTOR_TEST
        range 10 100
        default 60

    config PROMETEO_TEST_RAMP_MS
        int "Duracion de la subida de potencia (ms)"
        depends on PROMETEO_BUILD_MOTOR_TEST
        range 200 10000
        default 1500

    config PROMETEO_TEST_HOLD_MS
        int "Tiempo a potencia maxima (ms)"
        depends on PROMETEO_BUILD_MOTOR_TEST
        range 100 10000
        default 800

    config PROMETEO_TEST_PAUSE_MS
        int "Pausa entre pasos (ms)"
        depends on PROMETEO_BUILD_MOTOR_TEST
        range 100 10000
        default 700

endmenu
